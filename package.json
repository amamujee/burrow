{
  "name": "burrow",
  "version": "0.1.0",
  "description": "A local-first learning game that turns kids' interests into visual reading, math, science, and geography practice.",
  "private": true,
  "homepage": "https://github.com/amamujee/burrow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amamujee/burrow.git"
  },
  "bugs": {
    "url": "https://github.com/amamujee/burrow/issues"
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "npm run generate:offline-manifest",
    "dev": "next dev",
    "prebuild": "npm run generate:offline-manifest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:images": "node scripts/check-images.mjs",
    "generate:offline-manifest": "node scripts/generate-offline-asset-manifest.mjs",
    "check:offline-manifest": "node scripts/generate-offline-asset-manifest.mjs --check",
    "check:category": "node scripts/check-category.mjs",
    "validate:packs": "node scripts/validate-packs.mjs",
    "test:logic": "playwright test --config=playwright.logic.config.ts",
    "test:e2e:run": "playwright test --project=desktop --project=mobile",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "qa:content": "node scripts/qa-content.mjs",
    "analyze:play-events": "node scripts/analyze-play-events.mjs",
    "sync:assets": "node scripts/sync-content-assets.mjs",
    "qa:fast": "npm run lint && npm run validate:packs && npm run check:images && npm run check:offline-manifest && npm run qa:content && npm run test:logic",
    "qa:deep": "npm run qa:fast && npm run build && playwright test --project=desktop --project=mobile-full",
    "verify": "npm run qa:fast && npm run build && npm run test:e2e:run"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
